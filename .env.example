BOT_TOKEN=123456:CHANGE_ME
TIMEZONE=Asia/Baghdad
DATABASE_PATH=data/streak.db

# Telegram private-chat fire effect. Leave empty to disable.
MESSAGE_EFFECT_ID=5107584321108051014

# Required: numeric Telegram user ID of the developer who owns the shared packs.
STICKER_SET_OWNER_ID=
STICKER_SET_TITLE=Jake Streak

# Story videos always use a short random YouTube music clip.
# Optional cookies file improves YouTube reliability on cloud hosting.
STORY_YOUTUBE_COOKIE_FILE=
STORY_MUSIC_ATTEMPTS=3

# Preview publish requests expire automatically.
STORY_SHARE_TTL_SECONDS=900
